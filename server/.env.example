# Modèle de secrets du serveur. Copier en « .env » (ignoré par git) :
#     cp server/.env.example server/.env

# Compte MQTT du serveur (étape 15), créé par « make mqtt-user NAME=voice-server ».
# Sans guillemets ; mot de passe en hexadécimal (openssl rand -hex 16) : le Makefile
# relit ce fichier pour les cibles mqtt-*, et « # » ou « $ » y seraient mal compris.
MQTT_USERNAME=
MQTT_PASSWORD=

# Jeton Hugging Face, nécessaire aux modèles pyannote (étape 8).
# À créer sur https://huggingface.co/settings/tokens — ne jamais versionner.
HF_TOKEN=
