#pragma once

/**
 * @file secrets.h.example
 * @brief Modèle de configuration sensible.
 *
 * Copier ce fichier en « secrets.h » et renseigner les valeurs réelles :
 *     cp include/secrets.h.example include/secrets.h
 *
 * « secrets.h » est ignoré par git : il ne doit JAMAIS être versionné.
 * Ces valeurs ne sont utilisées qu'à partir de l'étape 3 (Wi-Fi + MQTT).
 */

// ------------------------------------------------------------------------ Wi-Fi

/// Réseau 2,4 GHz obligatoire : l'ESP32 ne sait pas se connecter en 5 GHz.
static constexpr const char* WIFI_SSID     = "mon-reseau";
static constexpr const char* WIFI_PASSWORD = "mon-mot-de-passe";

// ------------------------------------------------------------------------- MQTT

/// Adresse IP du broker Mosquitto (Raspberry Pi ou PC). Une adresse IP plutôt
/// qu'un nom : pas de résolution DNS, donc pas d'attente supplémentaire.
/// Sur Linux : `ip -4 addr` sur la machine du broker.
static constexpr const char* MQTT_HOST = "192.168.1.104";
static constexpr uint16_t    MQTT_PORT = 1883;

/// Compte MQTT de la carte (étape 15), créé par « make mqtt-user NAME=esp32-01 ».
/// MQTT_USER vide = DEVICE_ID (config.h) : c'est ce nom que les droits du broker
/// (mosquitto/acl) attendent. MQTT_PASSWORD vide = connexion anonyme, refusée par
/// un broker sécurisé.
static constexpr const char* MQTT_USER     = "";
static constexpr const char* MQTT_PASSWORD = "";
